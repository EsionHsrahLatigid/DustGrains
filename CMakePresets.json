{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "engine-debug",
      "displayName": "DustGrains DSP engine tests (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/engine-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DUSTGRAINS_BUILD_PLUGIN": "OFF",
        "DUSTGRAINS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "plugin-release",
      "displayName": "DustGrains Standalone, VST3, and AU (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/plugin-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DUSTGRAINS_BUILD_PLUGIN": "ON",
        "DUSTGRAINS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "plugin-install",
      "displayName": "Local plugin install (Release)",
      "inherits": "plugin-release",
      "cacheVariables": {
        "EHL_COPY_PLUGIN_AFTER_BUILD": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "engine-debug",
      "configurePreset": "engine-debug"
    },
    {
      "name": "plugin-release",
      "configurePreset": "plugin-release",
      "targets": [
        "dustgrains_engine_tests",
        "dustgrains_plugin_bridge_tests",
        "ehl_stage_products"
      ]
    },
    {
      "name": "plugin-install",
      "configurePreset": "plugin-install",
      "inherits": "plugin-release"
    }
  ],
  "testPresets": [
    {
      "name": "engine-debug",
      "configurePreset": "engine-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "plugin-release",
      "configurePreset": "plugin-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "plugin-install",
      "configurePreset": "plugin-install",
      "inherits": "plugin-release"
    }
  ]
}
